<?xml version="1.0" encoding="UTF-8"?>
<!--
  Where CI reads the VanillaBP artifacts this repository does not build itself.

  Until 2.0.0 is released to Maven Central, every framework repository publishes its
  snapshots to a GitHub Packages registry of its own. GitHub Packages asks for credentials
  even for a public package, so the servers below carry the repository secrets
  VANILLABP_USER_NAME and VANILLABP_USER_TOKEN. The token carries 'read:packages' and
  nothing else.

  The list is what this repository needs, not what VanillaBP publishes. More repositories
  publish to GitHub Packages than are named here. Add one when a build here starts to
  resolve an artifact it publishes, and take it out again when no build does.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <activeProfiles>
        <activeProfile>github</activeProfile>
    </activeProfiles>
    <profiles>
        <profile>
            <id>github</id>
            <repositories>
                <repository>
                    <id>central</id>
                    <url>https://repo1.maven.org/maven2</url>
                    <snapshots>
                        <enabled>false</enabled>
                    </snapshots>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                </repository>
                <!-- what the adapter plugs into: io.vanillabp.adapter:migration-adapter,
                     vanillabp-adapter-spi and the Spring Boot and Quarkus integrations, plus
                     io.vanillabp:test-utils for the tests -->
                <repository>
                    <id>vanillabp-adapter-platform-integration</id>
                    <url>https://maven.pkg.github.com/vanillabp/adapter-platform-integration</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                </repository>
                <!-- io.vanillabp:spi-for-java, the interfaces an application programs against and
                     the adapter serves -->
                <repository>
                    <id>vanillabp-spi-for-java</id>
                    <url>https://maven.pkg.github.com/vanillabp/spi-for-java</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                    <releases>
                        <enabled>false</enabled>
                    </releases>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <servers>
        <!-- used for "mvn deploy" due to pom's distributionManagement/snapshotRepository -->
        <server>
            <id>github</id>
            <username>${env.USER_NAME}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
        <!-- used for retrieving SNAPSHOT dependencies -->
        <server>
            <id>vanillabp-adapter-platform-integration</id>
            <username>${env.USER_NAME}</username>
            <password>${env.USER_TOKEN}</password>
        </server>
        <server>
            <id>vanillabp-spi-for-java</id>
            <username>${env.USER_NAME}</username>
            <password>${env.USER_TOKEN}</password>
        </server>
    </servers>

</settings>
