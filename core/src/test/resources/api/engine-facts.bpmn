<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="EngineFactsDefinitions"
                  targetNamespace="http://vanillabp.io/test">
  <bpmn:process id="EngineFactsProcess" isExecutable="true" camunda:historyTimeToLive="1">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>ToSubProcess</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="ToSubProcess" sourceRef="Start" targetRef="Orders" />
    <bpmn:subProcess id="Orders">
      <bpmn:incoming>ToSubProcess</bpmn:incoming>
      <bpmn:outgoing>ToEnd</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true"
                                             camunda:collection="orders"
                                             camunda:elementVariable="order" />
      <bpmn:startEvent id="SubStart">
        <bpmn:outgoing>ToApprove</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="ToApprove" sourceRef="SubStart" targetRef="Approve" />
      <bpmn:userTask id="Approve" camunda:formKey="${formKeyOfTheDay}">
        <bpmn:incoming>ToApprove</bpmn:incoming>
        <bpmn:outgoing>ToSubEnd</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="ToSubEnd" sourceRef="Approve" targetRef="SubEnd" />
      <bpmn:endEvent id="SubEnd">
        <bpmn:incoming>ToSubEnd</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="ToEnd" sourceRef="Orders" targetRef="End" />
    <bpmn:endEvent id="End">
      <bpmn:incoming>ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
