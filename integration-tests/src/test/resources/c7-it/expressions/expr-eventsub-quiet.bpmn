<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ExprEventSubQuiet" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="ExprEventSubQuiet" isExecutable="true">
    <bpmn:startEvent id="EQ_Start"><bpmn:outgoing>EQ_f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="EQ_f1" sourceRef="EQ_Start" targetRef="EQ_Park" />
    <bpmn:intermediateCatchEvent id="EQ_Park" camunda:asyncBefore="true">
      <bpmn:incoming>EQ_f1</bpmn:incoming>
      <bpmn:outgoing>EQ_f2</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="EQ_f2" sourceRef="EQ_Park" targetRef="EQ_End" />
    <bpmn:endEvent id="EQ_End"><bpmn:incoming>EQ_f2</bpmn:incoming></bpmn:endEvent>
    <bpmn:subProcess id="EQ_Sub" triggeredByEvent="true">
      <bpmn:startEvent id="EQ_SubStart" isInterrupting="false">
        <bpmn:outgoing>EQ_sf1</bpmn:outgoing>
        <bpmn:conditionalEventDefinition>
          <bpmn:condition xsi:type="bpmn:tFormalExpression">${order.internalCode == 'IC-9'}</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="EQ_sf1" sourceRef="EQ_SubStart" targetRef="EQ_SubEnd" />
      <bpmn:endEvent id="EQ_SubEnd"><bpmn:incoming>EQ_sf1</bpmn:incoming></bpmn:endEvent>
    </bpmn:subProcess>
  </bpmn:process>
</bpmn:definitions>
