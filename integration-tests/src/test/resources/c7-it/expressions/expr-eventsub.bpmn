<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ExprEventSub" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="ExprEventSub" isExecutable="true">
    <bpmn:startEvent id="EE_Start"><bpmn:outgoing>EE_f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:sequenceFlow id="EE_f1" sourceRef="EE_Start" targetRef="EE_Park" />
    <bpmn:intermediateCatchEvent id="EE_Park" camunda:asyncBefore="true">
      <bpmn:incoming>EE_f1</bpmn:incoming>
      <bpmn:outgoing>EE_f2</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="EE_f2" sourceRef="EE_Park" targetRef="EE_End" />
    <bpmn:endEvent id="EE_End"><bpmn:incoming>EE_f2</bpmn:incoming></bpmn:endEvent>
    <bpmn:subProcess id="EE_Sub" triggeredByEvent="true">
      <bpmn:startEvent id="EE_SubStart" isInterrupting="false">
        <bpmn:outgoing>EE_sf1</bpmn:outgoing>
        <bpmn:conditionalEventDefinition>
          <bpmn:condition xsi:type="bpmn:tFormalExpression">${order.getTotal() &gt; 100}</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="EE_sf1" sourceRef="EE_SubStart" targetRef="EE_SubEnd" />
      <bpmn:endEvent id="EE_SubEnd"><bpmn:incoming>EE_sf1</bpmn:incoming></bpmn:endEvent>
    </bpmn:subProcess>
  </bpmn:process>
</bpmn:definitions>
