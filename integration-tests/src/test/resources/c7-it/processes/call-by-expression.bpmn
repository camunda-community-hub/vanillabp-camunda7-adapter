<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_CallByExpression" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- the same called process reached in the two ways a model can name it: by its id,
       and by an expression the application fills. Both call activities call a process
       working on the aggregate of this one, so the task of the called process has to
       reach the aggregate this workflow was started with, whichever way it was named.
       The called process lives in a file of its own, the way an application splits
       them. -->
  <bpmn:process id="CallByExpressionCaller" isExecutable="true">
    <bpmn:startEvent id="CBE_Start">
      <bpmn:outgoing>CBE_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="CBE_f1" sourceRef="CBE_Start" targetRef="CBE_Gateway" />
    <bpmn:exclusiveGateway id="CBE_Gateway" default="CBE_fById">
      <bpmn:incoming>CBE_f1</bpmn:incoming>
      <bpmn:outgoing>CBE_fByExpression</bpmn:outgoing>
      <bpmn:outgoing>CBE_fById</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="CBE_fByExpression" sourceRef="CBE_Gateway" targetRef="CBE_CallByExpression">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${callByExpression}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:callActivity id="CBE_CallByExpression" calledElement="${processToCall}">
      <bpmn:incoming>CBE_fByExpression</bpmn:incoming>
      <bpmn:outgoing>CBE_f2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="CBE_f2" sourceRef="CBE_CallByExpression" targetRef="CBE_End" />
    <bpmn:sequenceFlow id="CBE_fById" sourceRef="CBE_Gateway" targetRef="CBE_CallById" />
    <bpmn:callActivity id="CBE_CallById" calledElement="CallByExpressionChild">
      <bpmn:incoming>CBE_fById</bpmn:incoming>
      <bpmn:outgoing>CBE_f3</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="CBE_f3" sourceRef="CBE_CallById" targetRef="CBE_End" />
    <bpmn:endEvent id="CBE_End">
      <bpmn:incoming>CBE_f2</bpmn:incoming>
      <bpmn:incoming>CBE_f3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
