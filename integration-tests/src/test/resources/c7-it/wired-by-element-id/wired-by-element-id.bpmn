<?xml version="1.0" encoding="UTF-8"?>
<!-- Both wirings of this model name something the serving method does NOT name. The
     service task is wired by an expression nobody declares a method for, the user task
     carries a form key, and both methods are wired by the element id instead. The
     application has to run this model, because the wiring validation accepts it. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_WiredByElementId" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="WiredByElementIdProcess" isExecutable="true">
    <bpmn:startEvent id="IW_Start">
      <bpmn:outgoing>IW_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="IW_f1" sourceRef="IW_Start" targetRef="IW_Task" />
    <bpmn:serviceTask id="IW_Task" camunda:delegateExpression="${theExpressionNobodyNames}">
      <bpmn:incoming>IW_f1</bpmn:incoming>
      <bpmn:outgoing>IW_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="IW_f2" sourceRef="IW_Task" targetRef="IW_UserTask" />
    <bpmn:userTask id="IW_UserTask" camunda:formKey="aFormNobodyServes">
      <bpmn:incoming>IW_f2</bpmn:incoming>
      <bpmn:outgoing>IW_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="IW_f3" sourceRef="IW_UserTask" targetRef="IW_End" />
    <bpmn:endEvent id="IW_End">
      <bpmn:incoming>IW_f3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
