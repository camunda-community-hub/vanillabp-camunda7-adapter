<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_Called" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="CalledProcess" isExecutable="true">
    <bpmn:startEvent id="StartEvent_2">
      <bpmn:outgoing>Flow_start_to_task</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_to_task" sourceRef="StartEvent_2" targetRef="ServiceTask_2" />
    <bpmn:serviceTask id="ServiceTask_2" camunda:expression="${calledTask}">
      <bpmn:incoming>Flow_start_to_task</bpmn:incoming>
      <bpmn:outgoing>Flow_task_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_task_to_end" sourceRef="ServiceTask_2" targetRef="EndEvent_2" />
    <bpmn:endEvent id="EndEvent_2">
      <bpmn:incoming>Flow_task_to_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
