<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_TimerStart"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="TimerStartProcess" isExecutable="true">
    <bpmn:startEvent id="DailyTimer">
      <bpmn:outgoing>Flow_ToRecord</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression"
                           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">PT1S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToRecord" sourceRef="DailyTimer" targetRef="Activity_Record" />
    <bpmn:serviceTask id="Activity_Record" camunda:expression="${recordStart}">
      <bpmn:incoming>Flow_ToRecord</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Activity_Record" targetRef="Event_End" />
    <bpmn:endEvent id="Event_End">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
