<?xml version="1.0" encoding="UTF-8"?>
<!-- Version 2 of the process: the task 'droppedInVersionTwo' is gone. Workflows
     started on version 1 still sit in it, and whether this application still serves
     them is what the startup check reports. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_OldProcessVersionsV2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="OldProcessVersionsProcess" isExecutable="true">
    <bpmn:startEvent id="OPV_Start">
      <bpmn:outgoing>OPV_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="OPV_f1" sourceRef="OPV_Start" targetRef="OPV_Kept" />
    <bpmn:serviceTask id="OPV_Kept" camunda:expression="${keptInBothVersions}">
      <bpmn:incoming>OPV_f1</bpmn:incoming>
      <bpmn:outgoing>OPV_f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="OPV_f2" sourceRef="OPV_Kept" targetRef="OPV_End" />
    <bpmn:endEvent id="OPV_End">
      <bpmn:incoming>OPV_f2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
